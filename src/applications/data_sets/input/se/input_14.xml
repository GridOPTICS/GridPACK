<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <State_estimation>
    <networkConfiguration> IEEE14.raw </networkConfiguration>
    <measurementList>IEEE14_meas.xml</measurementList>
    <tolerance>1.0e-3</tolerance>
    <maxIteration> 20 </maxIteration> 
    <badDataThreshold> 3.0 </badDataThreshold>
    <useVoltageConstraints> false </useVoltageConstraints>
    <enforceVoltageLimits> false </enforceVoltageLimits>
    <minVoltage> 0.9 </minVoltage>
    <maxVoltage> 1.1 </maxVoltage>
    <voltageConstraintDeviation> 0.0025 </voltageConstraintDeviation>
    <!--
    <LinearSolver>
      <SolutionTolerance>1.0E-10</SolutionTolerance>
      <RelativeTolerance>1.0E-6</RelativeTolerance>
      <MaxIterations>10</MaxIterations>
      <PETScOptions>
        -ksp_monitor
        -ksp_view
        -ksp_divtol 1.0E-06
      </PETScOptions>
    </LinearSolver>
    -->
    <LinearSolver>
      <PETScOptions>
        -ksp_view
        -ksp_type richardson
        -pc_type lu
        -pc_factor_mat_solver_type superlu_dist
        -ksp_max_it 1
      </PETScOptions>
    </LinearSolver>
  </State_estimation>
</Configuration>
